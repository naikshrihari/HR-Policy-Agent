# HR Policy Agent configuration.
# Copy this file to ".env" (in the project root) and edit. Settings here persist
# across terminals so you don't have to re-export env vars every session.
# Real environment variables override anything set here.

# ─────────────────────────── LLM (answer generation) ───────────────────────────
# Provider: fake | ollama | openai | anthropic
# NOTE: "fake" does NOT write answers — it echoes retrieved text. Use a real
# provider (e.g. ollama) for actual answers.
HRPA_LLM_PROVIDER=ollama
HRPA_LLM_MODEL=llama3.2:3b            # a small model is much faster on CPU
# HRPA_LLM_API_KEY=sk-...             # for openai / anthropic
HRPA_OLLAMA_BASE_URL=http://localhost:11434
HRPA_OLLAMA_NUM_CTX=8192

# Fast mode: deterministic routing + one compact answer call (big speedup locally).
HRPA_FAST_MODE=true
# HRPA_TIMING=true                    # print per-LLM-node timings to stderr

# ─────────────────────────── RAG (document retrieval) ──────────────────────────
# IMPORTANT: leave this false to actually search YOUR documents. When true (the
# default), a mock retriever returns the SAME canned passage for every question.
HRPA_USE_MOCK_RAG=false
HRPA_RAG_CORPUS_DIR=data/corpus

# Retrieval backend: tfidf (in-memory, no embeddings) | chroma (vector DB)
HRPA_RAG_BACKEND=tfidf

# --- Only needed for the chroma backend (run `python -m scripts.ingest` first) ---
HRPA_CHROMA_DIR=data/chroma
HRPA_EMBEDDING_PROVIDER=ollama        # ollama | openai | huggingface | fake
HRPA_EMBEDDING_MODEL=nomic-embed-text

# ─────────────────────────── HCM / chat store (optional) ───────────────────────
HRPA_USE_MOCK_HCM=true
HRPA_USE_MOCK_CHAT_STORE=true
# HRPA_HCM_BASE_URL=https://your-fusion-host
# HRPA_CHAT_STORE_URL=https://your-ords-endpoint
