# ============================================================================
#  HR Policy Agent — configuration
#  Copy this file to ".env" (in the project root) and edit.
#  Every PowerShell window / the web server reads this automatically, so you do
#  NOT have to re-export $env: variables each session. Real environment
#  variables still override anything set here.
#  Run commands from the project folder so this .env is found.
# ============================================================================

# ─────────────────────────────  LLM (writes the answer)  ────────────────────
# Provider that generates answers.  fake | ollama | openai | anthropic
#   fake   = offline stub, ECHOES retrieved text (no real answer) — demo/tests only
#   ollama = local, private, no API key (needs `ollama serve`)  ← recommended
HRPA_LLM_PROVIDER=ollama

# Chat model id for the provider above.
#   Ollama: pull it first, e.g. `ollama pull llama3.1:8b`
#   A 3B model (llama3.2:3b) is faster but over-shares; 8B follows instructions better.
HRPA_LLM_MODEL=llama3.1:8b

# API key / custom endpoint — only for openai / anthropic (leave blank for ollama).
#HRPA_LLM_API_KEY=sk-...
#HRPA_LLM_BASE_URL=

# Ollama server URL and context window (must be big enough to hold the prompt).
HRPA_OLLAMA_BASE_URL=http://localhost:11434
HRPA_OLLAMA_NUM_CTX=8192

# ─────────────────────────────  Speed / behaviour  ─────────────────────────
# Fast mode: deterministic routing + ONE compact answer call (much faster locally).
# When true, the answer prompt lives in code (hr_policy_agent/llm_nodes.py
# _compact_prompt); when false, the full ANSWER_AGENT_/FINAL_ANWER_GENERATOR
# prompt files are used (slower, more faithful).
HRPA_FAST_MODE=true

# Print per-LLM-node timings to stderr (diagnostics). true | false
HRPA_TIMING=false

# How many characters of retrieved context the fast-mode answer prompt may use.
# Higher = more supporting chunks reach the model (better recall, a bit slower).
HRPA_ANSWER_CONTEXT_CHARS=5000

# ─────────────────────────────  RAG — your documents  ──────────────────────
# IMPORTANT: false = search YOUR documents. true (default) = mock retriever that
# returns the SAME canned passage for every question.
HRPA_USE_MOCK_RAG=false

# Folder holding the handbooks, one sub-folder per Oracle tool code:
#   data/corpus/NON_REP_ENGLISH_DOCUMENT_TOOL_WORKFLOW_V3/<your .pdf/.docx/.txt>
#   data/corpus/REP_ENGLISH_DOCUMENT_TOOL_WORKFLOW_V3/...
#   data/corpus/TAVERN_ENGLISH_DOCUMENT_TOOL_WORKFLOW_V3/...
HRPA_RAG_CORPUS_DIR=data/corpus

# Retrieval backend:
#   tfidf  = keyword search, in-memory, no embeddings (simplest)
#   chroma = semantic vector search, persistent (best quality)  ← recommended
HRPA_RAG_BACKEND=chroma

# Where the Chroma vector DB is stored (built by `python -m scripts.ingest`).
HRPA_CHROMA_DIR=data/chroma

# How many chunks to retrieve per question, and how documents are chunked.
# Smaller chunk size keeps each policy separate (less unrelated text in answers).
HRPA_RAG_TOP_K=6
HRPA_RAG_CHUNK_SIZE=600
HRPA_RAG_CHUNK_OVERLAP=150

# ─────────────────────────────  Embeddings (chroma backend)  ────────────────
# MUST match at ingest time and at query time — embeddings from one model
# cannot be searched with another.  ollama | openai | huggingface | fake
HRPA_EMBEDDING_PROVIDER=ollama
# Ollama: `ollama pull nomic-embed-text`   OpenAI: text-embedding-3-small
HRPA_EMBEDDING_MODEL=nomic-embed-text

# ─────────────────────────────  HCM / chat store (optional)  ────────────────
# Team-Member lookup and analytics logging. Leave mocked unless you have the
# Oracle Fusion endpoints.
HRPA_USE_MOCK_HCM=true
#HRPA_HCM_BASE_URL=https://your-fusion-host
#HRPA_HCM_USERNAME=
#HRPA_HCM_PASSWORD=
HRPA_USE_MOCK_CHAT_STORE=true
#HRPA_CHAT_STORE_URL=https://your-ords-endpoint

# Person number used when there is no live HCM session (drives Tavern/Represented/
# Non-Represented classification via the mock).
HRPA_DEFAULT_PERSON_NUMBER=123456789
